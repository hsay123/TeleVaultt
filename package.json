{
  "name": "televault-site",
  "version": "0.1.0",
  "private": true,
  "description": "TeleVault — open-source landing page and contributor documentation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "http-server . -p 4173 -c-1 --silent",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "html-validate index.html contribute.html download.html privacy.html terms.html 404.html",
    "check:links": "start-server-and-test dev http://127.0.0.1:4173 check:links:run",
    "check:links:run": "linkinator http://127.0.0.1:4173 --recurse --skip \"github\\.com|github\\.io|shields\\.io|opensource\\.org|vercel\\.app\" --silent",
    "check:repos": "node scripts/check-repo-links.mjs",
    "check:site-url": "node scripts/check-site-url.mjs",
    "check:downloads": "node scripts/check-downloads.mjs",
    "check:downloads:online": "node scripts/check-downloads.mjs --online",
    "set-release": "node scripts/set-release.mjs",
    "set-site-url": "node scripts/set-site-url.mjs",
    "build": "node scripts/build-site.mjs",
    "test": "playwright test",
    "lighthouse": "lhci autorun",
    "check": "npm run format:check && npm run lint && npm run check:site-url && npm run check:repos && npm run check:downloads && npm run check:links",
    "vendor": "node scripts/vendor.mjs"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "lucide": "1.73.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "html-validate": "11.21.1",
    "http-server": "14.1.1",
    "linkinator": "8.1.0",
    "prettier": "3.10.1",
    "start-server-and-test": "3.0.13"
  }
}
